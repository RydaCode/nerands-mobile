{
  "expo": {
    "name": "Nerands",
    "slug": "Nerands",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/core-img/APPICON1.png",
    "scheme": "nerands",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nerands.marketplace",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to show nearby stores, transporters, and runners."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyD7UJW4D9PbCB7odPwvLqetEKjzqMLfrrA"
      }
    },
    "android": {
      "package": "com.nerands.marketplace",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/core-img/APPICON1.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],

      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],

      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD7UJW4D9PbCB7odPwvLqetEKjzqMLfrrA"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/core-img/NEWLOGO.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ac6bca72-b778-4085-8312-b675809d6520"
      }
    }
  }
}
